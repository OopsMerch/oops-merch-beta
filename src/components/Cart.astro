<div class="cart-modal-overlay" id="cart-overlay">
    <div class="cart-modal">
        <header class="cart-header">
            <h2>Корзина</h2>
            <button class="cart-close-btn" id="cart-close"><i class="fas fa-times"></i></button>
        </header>
        <div class="cart-body" id="cart-items-view">
            <div id="cart-list"></div>
        </div>
        <footer class="cart-footer">
            <div class="cart-total-details" id="cart-total-block">
                <div class="cart-total-row"><span>Товары:</span><span id="items-total-price">0 ₽</span></div>
                <div class="cart-total-row"><span>Доставка:</span><span id="delivery-price-display-footer" class="delivery-free-text">бесплатно</span></div>
                <div class="cart-grand-total"><span>Итого:</span><span id="cart-grand-total-price">0 ₽</span></div>
            </div>
            <button class="checkout-btn" id="cart-action-btn">Оформить заказ в Telegram</button>
        </footer>
    </div>
</div>
