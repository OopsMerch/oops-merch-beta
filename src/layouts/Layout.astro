---
import Header from '../components/Header.astro';
import SideMenu from '../components/SideMenu.astro';
import Cart from '../components/Cart.astro';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import '../styles/style.css';

const { title } = Astro.props;
const allProducts = await getCollection('products');
const legacyProductsData = JSON.stringify(allProducts.map(p => ({ ...p.data, slug: p.id })));
---

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <ClientRouter />
</head>
<body class="preload">
    <Header />
    <SideMenu />
    
    <main class="main-content" transition:animate="fade">
        <slot />
    </main>
    
    <Cart />
    <div class="menu-overlay"></div>
    
    <script define:vars={{ legacyProductsData }}>
        window.productsData = JSON.parse(legacyProductsData);
    </script>
    <script is:inline src="/js/main.js"></script>

    <div id="beta-lock-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:#000; z-index:2147483647; flex-direction:column; align-items:center; justify-content:center; color:#fff; font-family:'Montserrat',sans-serif;">
        <div style="text-align:center; max-width:320px; padding:20px;">
            <div style="font-size:3rem; margin-bottom:20px;">🔒</div>
            <h2 style="margin-bottom:10px; font-weight:800; letter-spacing:1px;">OOPS BETA</h2>
            <p style="margin-bottom:25px; color:#888;">Доступ для тестеров</p>
            
            <input type="text" id="beta-pass" placeholder="Код доступа" autocomplete="off" style="width:100%; padding:14px; border-radius:12px; border:1px solid #333; background:#111; color:#fff; outline:none; text-align:center; margin-bottom:15px; font-size:1.1rem; font-weight:600;">
            
            <button id="beta-btn" style="width:100%; padding:14px; background:#fff; color:#000; font-weight:700; border:none; border-radius:12px; cursor:pointer;">ОТКРЫТЬ</button>
            
            <p id="beta-error" style="color:#ff4444; margin-top:15px; display:none;">Неверный код</p>
        </div>
    </div>

    <script is:inline>
        function initLock() {
            const overlay = document.getElementById('beta-lock-overlay');
            const input = document.getElementById('beta-pass');
            const btn = document.getElementById('beta-btn');
            const error = document.getElementById('beta-error');

            // Если элементов нет (ошибка верстки), выходим
            if (!overlay || !input || !btn) return;

            // 1. Проверяем сохраненный доступ
            if (localStorage.getItem('oops_beta_access') === 'granted') {
                overlay.style.display = 'none';
                document.body.style.overflow = '';
                return;
            } else {
                overlay.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            }

            // 2. Логика открытия
            const unlock = () => {
                // ВАЖНО: .trim() удаляет пробелы с начала и конца строки
                const enteredPass = input.value.trim();
                const correctPass = 'oops-beta-2026';

                if (enteredPass === correctPass) {
                    localStorage.setItem('oops_beta_access', 'granted');
                    overlay.style.display = 'none';
                    document.body.style.overflow = '';
                } else {
                    error.style.display = 'block';
                    error.innerText = 'Неверный код';
                    input.style.borderColor = '#ff4444';
                }
            };

            // 3. Сбрасываем старые обработчики (клон элемента)
            const nBtn = btn.cloneNode(true);
            btn.parentNode.replaceChild(nBtn, btn);
            nBtn.addEventListener('click', unlock);

            const nInp = input.cloneNode(true);
            input.parentNode.replaceChild(nInp, input);
            nInp.addEventListener('keypress', (e) => { 
                if(e.key === 'Enter') unlock(); 
            });
            
            // Фокус на поле ввода (только на десктопе, чтобы на телефоне клавиатура не прыгала)
            if (window.innerWidth > 768) {
                setTimeout(() => nInp.focus(), 100);
            }
        }

        // Запуск при первой загрузке
        initLock();
        
        // Запуск при навигации (Astro Router)
        document.addEventListener('astro:page-load', initLock);
    </script>
</body>
</html>
