---
import Header from '../components/Header.astro';
import SideMenu from '../components/SideMenu.astro';
import Cart from '../components/Cart.astro';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import '../styles/style.css';

const { title } = Astro.props;
const allProducts = await getCollection('products');
const legacyProductsData = JSON.stringify(allProducts.map(p => ({ ...p.data, slug: p.id })));
---

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="icon" type="image/jpeg" href="/images/favicon.jpg">
    <ClientRouter />
</head>
<body class="preload">
    <script is:inline>
        // Функция: Уничтожить замок, если есть доступ
        function nukeLock() {
            const token = localStorage.getItem('oops_beta_token');
            const lock = document.getElementById('fatal-lock');
            
            if (token === 'granted' && lock) {
                lock.remove(); // ФИЗИЧЕСКОЕ УДАЛЕНИЕ ЗАМКА ИЗ DOM
                document.body.style.overflow = ''; // Разрешаем прокрутку
            } else if (!token && lock) {
                lock.style.display = 'flex'; // Показываем замок
                document.body.style.overflow = 'hidden'; // Блокируем прокрутку
            }
        }
        // Запускаем немедленно
        document.addEventListener('astro:page-load', nukeLock);
        document.addEventListener('DOMContentLoaded', nukeLock);
    </script>

    <Header />
    <SideMenu />
    <main class="main-content" transition:animate="fade">
        <slot />
    </main>
    <Cart />
    <div class="menu-overlay"></div>
    
    <script define:vars={{ legacyProductsData }}>
        window.productsData = JSON.parse(legacyProductsData);
    </script>
    <script is:inline src="/js/main.js"></script>

    <div id="fatal-lock" style="
        display: flex; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: #000; z-index: 2147483647; flex-direction: column;
        align-items: center; justify-content: center; color: #fff;
        font-family: 'Montserrat', sans-serif;
    ">
        <div style="text-align: center; max-width: 320px; padding: 20px;">
            <div style="font-size: 3rem; margin-bottom: 20px;">🔒</div>
            <h2 style="margin-bottom: 10px; font-weight: 800; letter-spacing: 1px;">OOPS BETA</h2>
            
            <input type="text" id="pass-input" placeholder="Код доступа" autocomplete="off" style="
                width: 100%; padding: 14px; border-radius: 12px; border: 1px solid #333;
                background: #111; color: #fff; outline: none; text-align: center; margin-bottom: 15px;
                font-size: 1.1rem; font-weight: 600;
            ">
            <button id="pass-btn" style="
                width: 100%; padding: 14px; background: #fff; color: #000; font-weight: 700;
                border: none; border-radius: 12px; cursor: pointer;
            ">ВОЙТИ</button>
            <p id="pass-error" style="color: #ff4444; margin-top: 15px; display: none;">НЕВЕРНЫЙ КОД</p>
        </div>
    </div>

    <script is:inline>
        // Логика ввода пароля
        function setupAuth() {
            const btn = document.getElementById('pass-btn');
            const inp = document.getElementById('pass-input');
            const err = document.getElementById('pass-error');
            
            if(!btn || !inp) return;

            // Сброс клонированием (чтобы не дублировались клики)
            const newBtn = btn.cloneNode(true);
            btn.parentNode.replaceChild(newBtn, btn);
            
            const newInp = inp.cloneNode(true);
            inp.parentNode.replaceChild(newInp, inp);

            const tryLogin = () => {
                // TRIM ВАЖЕН: убирает пробелы, которые ставит телефон
                if (newInp.value.trim() === 'oops-beta-2026') {
                    localStorage.setItem('oops_beta_token', 'granted');
                    // ПЕРЕЗАГРУЗКА: Гарантирует, что скрипт nukeLock сработает чисто
                    window.location.reload(); 
                } else {
                    err.style.display = 'block';
                    setTimeout(() => err.style.display = 'none', 2000);
                }
            };

            newBtn.addEventListener('click', tryLogin);
            newInp.addEventListener('keypress', (e) => { if(e.key === 'Enter') tryLogin(); });
            
            // Проверка при старте
            nukeLock();
        }

        setupAuth();
        document.addEventListener('astro:page-load', setupAuth);
        nukeLock(); // Контрольный выстрел
    </script>
</body>
</html>
